{
  "name": "hermes-relay",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "dev": "wrangler dev",
    "build": "wrangler deploy --dry-run --outdir dist",
    "typecheck": "tsc --noEmit && tsc --noEmit --project src && tsc --noEmit --project tests && tsc --noEmit --project tests/lint",
    "lint": "oxlint --ignore-pattern tests/lint/fixtures/",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "test": "vitest run",
    "check": "wrangler types && pnpm run --no-bail \"/^(typecheck|lint|format:check|test)$/\""
  },
  "dependencies": {
    "@octokit/oauth-methods": "6.0.5",
    "@octokit/request": "10.0.16",
    "@octokit/webhooks-methods": "6.0.0",
    "hono": "4.13.19",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "1.8.3",
    "@stylistic/eslint-plugin": "6.0.1",
    "@tsconfig/strictest": "2.0.9",
    "@types/node": "26.6.6",
    "oxfmt": "0.78.0",
    "oxlint": "1.93.0",
    "oxlint-plugin-eslint": "1.93.0",
    "oxlint-tsgolint": "7.0.2007",
    "typescript": "7.0.2",
    "vitest": "5.1.0",
    "wrangler": "4.162.0"
  }
}
