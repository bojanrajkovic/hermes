{
  "name": "hermes-relay",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "dev": "wrangler dev",
    "build": "wrangler deploy --dry-run --outdir dist",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "check": "wrangler types && pnpm run --no-bail \"/^(typecheck|test)$/\""
  },
  "dependencies": {
    "@octokit/oauth-methods": "6.0.5",
    "@octokit/request": "10.0.16",
    "@octokit/webhooks-methods": "6.0.0",
    "hono": "4.13.18",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "1.8.2",
    "typescript": "7.0.2",
    "vitest": "4.1.12",
    "wrangler": "4.162.0"
  }
}
