 ### Generated specs
 
 `@airway/contract/query/arbitrary` has two fast-check arbitraries built from the registry: `specInput`, a valid spec as written with optional fields left out at random, and `spec`, the same after parsing. Tests of anything that takes a spec use them.
+
+## Canonical form
+
+`canonicalize(spec)` in `@airway/contract/query/canonical` gives a query its one spelling, so two specs that ask the same thing share a link and a short code:
+
+- Keys come in a fixed order.
+- Anything equal to its default is left out, and so is `filter_combination` when there are fewer than two filters.
+- Each `in` and `not-in` list is sorted, without repeats.
+- Each time is written in UTC, so `02:00:00-04:00` and `06:00:00Z` are the same text.
+- A filter or having written twice is written once.
+
+Calculations, filters, breakdowns, orders, and havings keep the order they were written in. That order is the order of the builder's rows and of the charts.
+
+`canonicalJson(spec)` is the canonical spec as compact JSON. A canonical spec is itself a valid spec, and parsing it gives the same canonical form again. It isn't always the spec as first written: a list may be reordered and a time rewritten.
diff --git a/packages/contract/src/query/canonical.ts b/packages/contract/src/query/canonical.ts
new file mode 100644
index 0000000..1fcf371
--- /dev/null
+++ b/packages/contract/src/query/canonical.ts
@@ -0,0 +1,108 @@
+import {
+  DEFAULT_LIMIT,
+  instant,
+  type Filter,
+  type QuerySpec,
+  type QuerySpecInput,
+} from "./spec.ts";
+
+type Value = number | string | boolean;
+
+// Text is a time only when it carries a time and an offset, which no date or enum value does.
+const sameInstantInUtc = <Scalar extends Value>(value: Scalar): Scalar | string =>
+  typeof value === "string" && instant.safeParse(value).success
+    ? Temporal.Instant.from(value).toString()
+    : value;
+
+function ascending(one: Value, other: Value): number {
+  if (one === other) {
+    return 0;
+  }
+
+  return one < other ? -1 : 1;
+}
+
+type ListFilter = Extract<Filter, { value: unknown[] }>;
+const hasList = (filter: Filter): filter is ListFilter =>
+  "value" in filter && Array.isArray(filter.value);
+
+function canonicalFilter(filter: Filter): Filter {
+  const { column } = filter;
+
+  if (!("value" in filter)) {
+    return { column, op: filter.op };
+  }
+
+  if (hasList(filter)) {
+    const value = [...new Set(filter.value.map(sameInstantInUtc))].toSorted(ascending);
+
+    return { column, op: filter.op, value };
+  }
+
+  return { column, op: filter.op, value: sameInstantInUtc(filter.value) };
+}
+
+// The first of each: a filter or having written twice asks nothing more than once.
+const distinct = <Clause>(clauses: readonly Clause[]): Clause[] => [
+  ...new Map(clauses.map((clause) => [JSON.stringify(clause), clause])).values(),
+];
+
+/**
+ * The one spelling of a query: keys in a fixed order, defaults left out, each `in` list sorted
+ * without repeats, each time in UTC, and a repeated filter or having written once. Two specs that ask the same thing give the same JSON, so
+ * they share a link and a short code. Clauses keep the order they were written in, because that's
+ * the order of the builder's rows and the charts.
+ */
+export function canonicalize(spec: QuerySpec): QuerySpecInput {
+  const { nights, calculations, breakdowns, orders, havings } = spec;
+  const filters = distinct(spec.filters.map(canonicalFilter));
+
+  return {
+    v: spec.v,
+    dataset: spec.dataset,
+    nights: "last" in nights ? { last: nights.last } : { from: nights.from, to: nights.to },
+    ...(calculations.length === 1 && calculations[0]?.op === "COUNT"
+      ? {}
+      : {
+          calculations: calculations.map((calculation) =>
+            calculation.op === "COUNT"
+              ? { op: calculation.op }
+              : { op: calculation.op, column: calculation.column },
+          ),
+        }),
+    ...(filters.length === 0 ? {} : { filters }),
+    // With fewer than two filters there's nothing to combine, so OR asks the same as AND.
+    ...(spec.filter_combination === "AND" || filters.length < 2
+      ? {}
+      : { filter_combination: spec.filter_combination }),
+    ...(breakdowns.length === 0 ? {} : { breakdowns: [...breakdowns] }),
+    ...(orders.length === 0
+      ? {}
+      : {
+          orders: orders.map(({ op, column, order }) => ({
+            ...(op === undefined ? {} : { op }),
+            ...(column === undefined ? {} : { column }),
+            ...(order === "descending" ? {} : { order }),
+          })),
+        }),
+    ...(havings.length === 0
+      ? {}
+      : {
+          havings: distinct(
+            havings.map(({ calculate_op, column, op, value }) => ({
+              calculate_op,
+              ...(column === undefined ? {} : { column }),
+              op,
+              value: sameInstantInUtc(value),
+            })),
+          ),
+        }),
+    ...(spec.limit === DEFAULT_LIMIT ? {} : { limit: spec.limit }),
+    ...(spec.granularity === undefined ? {} : { granularity: spec.granularity }),
+  };
+}
+
+/** The canonical spec as compact JSON: the text that goes in a link and that a short code hashes. */
+export function canonicalJson(spec: QuerySpec): string {
+  return JSON.stringify(canonicalize(spec));
+}
diff --git a/packages/contract/src/query/link.ts b/packages/contract/src/query/link.ts
new file mode 100644
index 0000000..36603d5
--- /dev/null
+++ b/packages/contract/src/query/link.ts
@@ -0,0 +1,34 @@
+import { err, ok, Result } from "neverthrow";
+import { canonicalJson } from "./canonical.ts";
+import { parseSpec, type QuerySpec, type SpecIssue } from "./spec.ts";
+
+/**
+ * The longest explorer link, in characters of path and query. It leaves room under the server's
+ * header limit for cookies and the identity proxy's headers.
+ */
+export const LINK_LIMIT = 4000;
+
+/**
+ * The explorer link for a query: `/explore?q=` and its canonical JSON. A spec too long for a link
+ * is an error, and its short link is the one to share.
+ */
+export function toExploreUrl(spec: QuerySpec): Result<string, "too_long"> {
+  const url = `/explore?q=${encodeURIComponent(canonicalJson(spec))}`;
+
+  return url.length > LINK_LIMIT ? err("too_long") : ok(url);
+}
+
+/** A link's `q` that isn't a valid spec, with its text kept so the error view can show it. */
+export type BadExploreQuery = { raw: string; issues: SpecIssue[] };
+
+const parseJson = Result.fromThrowable(
+  (text: string): unknown => JSON.parse(text),
+  (): SpecIssue[] => [{ path: "", message: "the query isn't JSON" }],
+);
+
+/** Reads the decoded `q` of an explorer link. */
+export function parseExploreQuery(q: string): Result<QuerySpec, BadExploreQuery> {
+  return parseJson(q)
+    .andThen(parseSpec)
+    .mapErr((issues) => ({ raw: q, issues }));
+}
diff --git a/packages/contract/src/query/short-code.ts b/packages/contract/src/query/short-code.ts
new file mode 100644
index 0000000..c0c262c
--- /dev/null
+++ b/packages/contract/src/query/short-code.ts
@@ -0,0 +1,37 @@
+import { canonicalJson } from "./canonical.ts";
+import type { QuerySpec } from "./spec.ts";
+
+// This package compiles without DOM or Node types. The browser and Node both have these globals.
+declare const crypto: {
+  subtle: { digest: (algorithm: "SHA-256", data: Uint8Array) => Promise<ArrayBuffer> };
+};
+declare const TextEncoder: new () => { encode: (text: string) => Uint8Array };
+
+/** What a short link opens: a builder query or a SQL statement. */
+export type ShortLinkTarget = { kind: "spec"; spec: QuerySpec } | { kind: "sql"; text: string };
+
+// Crockford's base32 in lower case: no i, l, o, or u, so a code reads aloud without mix-ups.
+const ALPHABET = "0123456789abcdefghjkmnpqrstvwxyz";
+const LENGTH = 10;
+const BITS = 5n * BigInt(LENGTH);
+const BYTES = 7;
+
+/**
+ * The code in `/s/<code>`: ten characters from the SHA-256 of the target. The same query always
+ * gets the same code. The hash covers the kind, so a spec and a SQL text never share one.
+ */
+export async function shortCode(target: ShortLinkTarget): Promise<string> {
+  const text = target.kind === "spec" ? canonicalJson(target.spec) : target.text.trim();
+  const hash = await crypto.subtle.digest(
+    "SHA-256",
+    new TextEncoder().encode(`${target.kind}\n${text}`),
+  );
+  const leading = new Uint8Array(hash)
+    .slice(0, BYTES)
+    .reduce((bits, byte) => (bits << 8n) | BigInt(byte), 0n);
+  const bits = leading >> (BigInt(BYTES * 8) - BITS);
+
+  return Array.from({ length: LENGTH }, (_, index) =>
+    ALPHABET.charAt(Number((bits >> (5n * BigInt(LENGTH - 1 - index))) & 31n)),
+  ).join("");
+}
